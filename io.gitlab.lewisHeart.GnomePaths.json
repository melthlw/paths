{
  "app-id": "io.gitlab.lewisHeart.GnomePaths",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "gnome-paths",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=xdg-documents",
    "--filesystem=xdg-pictures",
    "--filesystem=xdg-download",
    "--metadata=X-DConf=migrate-path=/io/gitlab/lewisHeart/GnomePaths/"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/gnome-paths/cargo",
      "RUST_BACKTRACE": "1",
      "SKIA_BINARIES_URL": "file:///run/build/gnome-paths/skia-binaries-a25a0fdb7d90429aa2d1-x86_64-unknown-linux-gnu-jpegd-jpege-pdf.tar.gz"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "gnome-paths",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "."
        },
        {
          "type": "file",
          "url": "https://github.com/rust-skia/skia-binaries/releases/download/0.99.0/skia-binaries-a25a0fdb7d90429aa2d1-x86_64-unknown-linux-gnu-jpegd-jpege-pdf.tar.gz",
          "sha256": "5b776571b11194a9ed3a4c41824b7a4b35a83117aef99eb16a2ad3315db13b5d",
          "dest-filename": "skia-binaries-a25a0fdb7d90429aa2d1-x86_64-unknown-linux-gnu-jpegd-jpege-pdf.tar.gz"
        },
        "cargo-sources.json"
      ]
    }
  ]
}