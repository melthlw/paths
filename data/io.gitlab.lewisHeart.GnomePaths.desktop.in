[Desktop Entry]
Name=GNOME Paths
Comment=Create and edit vector graphics and illustrations
Exec=gnome-paths %F
Icon=io.gitlab.lewisHeart.GnomePaths
Terminal=false
Type=Application
Categories=GNOME;GTK;Graphics;VectorGraphics;2DGraphics;
Keywords=vector;svg;design;path;bezier;drawing;illustration;graphics;gnome;
MimeType=image/svg+xml;image/svg+xml-compressed;
StartupNotify=true
Actions=NewDocument;

[Desktop Action NewDocument]
Name=New Document
Exec=gnome-paths
